# Frontend: base URL of the backend API. Leave empty to use the same domain (/api).
VITE_API_BASE_URL=""

# Backend (set these in the Vercel project settings, never commit real values):
# Neon Postgres connection string (added automatically by the Neon integration).
DATABASE_URL=""
# Vercel Blob token for media uploads.
BLOB_READ_WRITE_TOKEN=""
# Admin panel login (/admin).
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# --- Phone sign-in (SMS one-time codes) ---
# Random secret (32+ characters) used to hash codes: openssl rand -hex 32
OTP_SECRET=""
# One of: kavenegar | smsir | ippanel | custom | console   (console prints the code to the log; refused on production)
SMS_PROVIDER=""
# kavenegar
KAVENEGAR_API_KEY=""
KAVENEGAR_TEMPLATE=""            # name of the verify template
# ippanel (pattern / template sending)
IPPANEL_API_KEY=""               # the panel's access key (secret)
IPPANEL_PATTERN_CODE=""          # code of an approved pattern that contains the verification code
IPPANEL_ORIGINATOR=""            # your sender line, e.g. +983000505
IPPANEL_PARAM_NAME="verification-code"   # the variable's name inside the pattern
# smsir
SMSIR_API_KEY=""
SMSIR_TEMPLATE_ID=""
SMSIR_PARAM_NAME="Code"          # the template's parameter name
# custom (any HTTP API). Placeholders: {{phone}} 0912..., {{phone10}} 912..., {{phone98}} 98912..., {{code}}, {{message}}
SMS_HTTP_URL=""
SMS_HTTP_METHOD="POST"           # POST or GET
SMS_HTTP_FORMAT="json"           # json or form (body encoding)
SMS_HTTP_HEADERS=""              # JSON object, e.g. {"Authorization":"Bearer ..."}
SMS_HTTP_BODY=""                 # e.g. {"to":"{{phone}}","text":"{{message}}"}
SMS_HTTP_SUCCESS_MATCH=""        # optional text the response must contain to count as sent
SMS_MESSAGE="کد ورود شما به درنگ: {{code}}"
# Limits
SMS_DAILY_LIMIT="1000"           # total codes per 24 hours, across all visitors (caps the SMS bill)
SMS_PER_IP_HOURLY="60"           # codes per hour from one network address
